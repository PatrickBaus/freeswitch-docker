--- a/bootstrap.sh
+++ b/bootstrap.sh
@@ -129,7 +129,14 @@ bootstrap_apr() {
 
   echo "bootstrap: Using libtool.m4 at ${ltfile}."
 
-  cat $ltfile | sed -e 's/LIBTOOL=\(.*\)top_build/LIBTOOL=\1apr_build/' > build/libtool.m4
+  # libtool 2.6.0 ships a libtool.m4 with a stray "])])[]dnl" + "])" after
+  # LT_PROG_OBJC and LT_PROG_OBJCXX. APR sinclude()s this file after AC_INIT,
