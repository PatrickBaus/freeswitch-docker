+  # Strip them; this is a no-op on unaffected libtool versions.
+  cat $ltfile | sed -e 's/LIBTOOL=\(.*\)top_build/LIBTOOL=\1apr_build/' | \
+    awk '{ if (skip) { skip = 0; if ($0 == "])") next } }
+         /AC_SUBST\(OBJC(XX)?FLAGS\)\]\)\]\)\[\]dnl$/ { sub(/\]\)\]\)\[\]dnl$/, "])"); skip = 1 }
+         { print }' > build/libtool.m4
 
   # libtool.m4 from 1.6 requires ltsugar.m4
   if [ -f ltsugar.m4 ]; then
